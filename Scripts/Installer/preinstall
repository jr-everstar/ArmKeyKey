#!/bin/bash
set -euo pipefail
# InputMethodKit may relaunch an input method after it quits. A process-name
# check is therefore not an installation precondition. PackageKit atomically
# replaces the complete bundle (BundleOverwriteAction=upgrade); RequireLogout
# ends old sessions after the user saves their work. Never kill input processes.
if [[ -L '/Library/Input Methods' || -L '/Library/Input Methods/ArmKeyKey.app' || ( -e '/Library/Input Methods/ArmKeyKey.app' && ! -d '/Library/Input Methods/ArmKeyKey.app' ) ]]; then
    echo '安裝位置是符號連結，請先檢查安裝位置。' >&2
    exit 1
fi
# Move old personal bundles out of the input-method search path. Keep every
# backup and all learning/preferences data, even if a later install step fails.
homes=(/Users/*)
console_user=$(/usr/bin/stat -f %Su /dev/console)
if [[ "$console_user" != root && "$console_user" != loginwindow ]]; then
    console_home=$(/usr/bin/dscl . -read "/Users/$console_user" NFSHomeDirectory | /usr/bin/sed 's/^NFSHomeDirectory: //')
    homes+=("$console_home")
fi
# Validate all sources before moving any; never follow user-controlled symlinks.
for user_home in "${homes[@]}"; do
    app="$user_home/Library/Input Methods/ArmKeyKey.app"
    if [[ ! -e "$app" && ! -L "$app" ]]; then continue; fi
    if [[ -L "$user_home" || -L "$user_home/Library" || -L "$user_home/Library/Input Methods" || -L "$app" || ! -d "$app" ]]; then
        echo "個人安裝位置不安全，請手動移走後重試：$app" >&2
        exit 1
    fi
done
# Preserve the shared bundle without removing it from the input-method path.
# Leave atomic replacement and rollback to PackageKit, not a move-and-copy gap.
if [[ -d '/Library/Input Methods/ArmKeyKey.app' ]]; then
    shared_backup=$(/usr/bin/mktemp -d '/Library/ArmKeyKey Installer Backup.XXXXXX')
    /bin/chmod 700 "$shared_backup"
    /usr/bin/ditto '/Library/Input Methods/ArmKeyKey.app' "$shared_backup/ArmKeyKey.app"
    echo "舊共用版本已備份至：$shared_backup/ArmKeyKey.app。完成安裝後請所有使用者登出再登入。"
fi
for user_home in "${homes[@]}"; do
    app="$user_home/Library/Input Methods/ArmKeyKey.app"
    if [[ ! -e "$app" ]]; then continue; fi
    backup=$(/usr/bin/mktemp -d "$user_home/Library/ArmKeyKey Installer Backup.XXXXXX")
    /bin/chmod 700 "$backup"
    /bin/mv "$app" "$backup/ArmKeyKey.app"
    /usr/sbin/chown "$(/usr/bin/stat -f '%u:%g' "$user_home")" "$backup"
    echo "舊個人版已備份至：$backup/ArmKeyKey.app；學習資料及設定保持不變。"
done
exit 0
